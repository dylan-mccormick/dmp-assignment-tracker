{
  "name": "assignment",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "tsc; node dist/index.js",
    "build": "tsc",
    "dev": "nodemon -e js,ts,env --watch 'src/' --exec 'tsc; node dist/index.js'",
    "proto:generate": "protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./src/generated --proto_path=./../../proto ./../../proto/*.proto --ts_proto_opt=outputServices=grpc-js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.10.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "nodemon": "^3.1.14",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.79.0",
    "ts-proto": "^2.12.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.15.0",
    "@grpc/grpc-js": "^1.14.5",
    "pg": "^8.23.1",
    "uuid": "^14.0.2"
  }
}
